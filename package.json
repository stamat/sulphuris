{
  "name": "sulphuris",
  "description": "An adaptable CSS utility library",
  "version": "4.0.0",
  "license": "MIT",
  "style": "dist/sulphuris.css",
  "sass": "src/index.scss",
  "main": "src/index.scss",
  "exports": {
    ".": {
      "sass": "./src/index.scss",
      "style": "./dist/sulphuris.css",
      "default": "./dist/sulphuris.css"
    },
    "./core/*": {
      "sass": "./src/core/*"
    },
    "./src/*": "./src/*",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "repository": "https://github.com/stamat/sulphuris.git",
  "keywords": [
    "css",
    "utility",
    "utility-classes",
    "sass",
    "scss",
    "adaptive",
    "responsive",
    "grid-system",
    "nested-grid"
  ],
  "author": "Stamat <@stamat> (https://github.com/stamat)",
  "homepage": "https://stamat.info/sulphuris",
  "private": false,
  "devDependencies": {
    "poops": "^1.9.2",
    "poops-docs-theme": "^1.1.2",
    "postcss": "^8.5.23",
    "sass": "^1.102.0",
    "stylelint": "^16.10.0",
    "stylelint-config-sass-guidelines": "^12.1.0",
    "typescript": "^5.6.3"
  },
  "scripts": {
    "dev": "npx poops",
    "build": "npx poops -b",
    "lint": "stylelint \"src/**/*.scss\"",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run build && node script/check-grid-css.mjs && node script/check-utility-css.mjs"
  }
}
