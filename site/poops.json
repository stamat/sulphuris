{
  "styles": [
    {
      "in": "../src/index.scss",
      "out": "dist/css/sulphuris.css",
      "options": { "minify": true, "justMinified": true }
    },
    {
      "in": "src/scss/docs.scss",
      "out": "dist/css/docs.css",
      "options": { "minify": true, "justMinified": true }
    }
  ],
  "scripts": [
    {
      "in": "src/js/docs.ts",
      "out": "dist/js/docs.js",
      "options": { "minify": true, "justMinified": true, "format": "iife", "target": "es2019" }
    }
  ],
  "markup": {
    "in": "src/markup",
    "out": "dist",
    "site": {
      "title": "🜍 Sulphuris",
      "description": "An adaptable, self-generating CSS utility library.",
      "url": "https://stamat.info/sulphuris"
    },
    "includePaths": ["_layouts", "_partials"],
    "searchIndex": "search-index.json",
    "sitemap": "sitemap.xml",
    "nav": {
      "output": "nav.json",
      "root": "docs",
      "collections": "index"
    }
  },
  "copy": {
    "in": [
      "../index.html",
      "../favicon.ico",
      "../favicon-16x16.png",
      "../favicon-32x32.png",
      "../sulphuris-logo.svg",
      "../dist"
    ],
    "out": "dist"
  },
  "serve": {
    "port": 4041,
    "base": "/dist"
  },
  "livereload": true,
  "watch": ["src", "../src"]
}
