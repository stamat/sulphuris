{
  "styles": [
    {
      "in": "src/scss/docs.scss",
      "out": "dist/css/docs.css",
      "options": { "minify": true, "justMinified": true }
    }
  ],
  "scripts": [
    {
      "in": "../node_modules/poops-docs-theme/src/docs.ts",
      "out": "dist/js/docs.js",
      "options": { "minify": true, "justMinified": true, "format": "iife", "target": "es2019" }
    }
  ],
  "markup": {
    "in": "src/markup",
    "out": "dist",
    "site": {
      "title": "🜍 Sulphuris",
      "brand": "Sulphuris",
      "brandMark": "🜍",
      "description": "An adaptable, self-generating CSS utility library.",
      "url": "https://stamat.info/sulphuris",
      "lang": "en",
      "author": "Stamat",
      "logo": "sulphuris-logo.svg",
      "repo": "https://github.com/stamat/sulphuris",
      "branch": "main"
    },
    "//data": "poops' built-in `package` global reads cwd/package.json and cwd is site/. Load the repo root one as data instead; key = basename, so it still lands as `package`. Resolved from markup.in.",
    "data": ["../../../package.json"],
    "searchIndex": "search-index.json",
    "sitemap": "sitemap.xml",
    "llms": {
      "output": "llms.txt",
      "description": "An adaptable, self-generating CSS utility library. You describe your design tokens, Sulphuris emits the utility classes.",
      "full": true
    },
    "nav": {
      "output": "nav.json",
      "root": "docs",
      "collections": "index"
    }
  },
  "copy": {
    "in": [
      "../favicon.ico",
      "../favicon-16x16.png",
      "../favicon-32x32.png",
      "../sulphuris-logo.svg",
      "../dist"
    ],
    "out": "dist"
  },
  "exec": {
    "markup": [
      "node ../script/gen-config-docs.mjs",
      "node ../script/gen-demos.mjs"
    ]
  },
  "serve": {
    "port": 4041,
    "base": "/dist"
  },
  "livereload": true,
  "watch": ["src", "../src", "../dist"]
}
