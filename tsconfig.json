{
  "compilerOptions": {
    "experimentalDecorators": true,
    "target": "es2019",
    "module": "es2020",
    "lib": ["es2019", "dom", "dom.iterable"],
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    // script/*.mjs is in the program (allowJs), so a dependency's own .d.ts
    // gets type-checked against a lib list that has no Node types in it.
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "resolveJsonModule": true
  },
  "exclude": ["node_modules", "eslint.config.mjs"]
}
