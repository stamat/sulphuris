{
  "compilerOptions": {
    "experimentalDecorators": true,
    "target": "es2020",
    "module": "es2020",
    "lib": ["es2020", "dom", "dom.iterable"],
    // "node" meant node10 resolution, which TypeScript 6 removed. "bundler" is
    // what poops resolves these imports with anyway.
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    // script/*.mjs is in the program (allowJs), so a dependency's own .d.ts
    // gets type-checked against a lib list that has no Node types in it.
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "resolveJsonModule": true
  },
  "exclude": ["node_modules", "eslint.config.mjs"]
}
