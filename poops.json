{
  "styles": {
    "in": "src/index.scss",
    "out": "dist/sulphuris.css",
    "options": {
      "sourcemap": true,
      "minify": true
    }
  },
  "banner": "/* {{ name }} v{{ version }} | {{ homepage }} | {{ license }} License */",
  "exec": {
    "styles": [
      "node script/strip-css-comments.mjs",
      "node script/gen-reference.mjs",
      "node script/gen-config-docs.mjs"
    ]
  },
  "watch": [
    "src"
  ]
}
